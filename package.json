{
    "name": "mnmo",
    "version": "1.0.37",
    "main": "lib/cjs/mnmo.js",
    "types": "lib/mnmo.d.ts",
    "typings": "lib/mnmo.d.ts",
    "module": "lib/esm/mnmo.js",
    "unpkg": "lib/umd/mnmo.min.js",
    "keywords": [],
    "author": {
        "name": "Bryan B Padilha",
        "email": "bryan@bryanbpadilha.com",
        "url": "https://bryanbpadilha.com/"
    },
    "files": [
        "lib"
    ],
    "license": "ISC",
    "description": "Headless UI in vanilla JS",
    "scripts": {
        "rollup": "rollup -c",
        "rollup:watch": "rollup -c -w",
        "build": "rm -rf lib && npm run rollup",
        "prepublishOnly": "npm run build",
        "prepare": "husky install",
        "docs:dev": "astro dev --root docs",
        "docs:build": "astro build --root docs",
        "docs:preview": "astro preview --root docs",
        "dev": "concurrently -k -n LIB,DOCS -c green,cyan \"npm:rollup:watch\" \"npm:docs:dev\""
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^11.1.6",
        "concurrently": "^7.6.0",
        "esbuild": "^0.17.6",
        "husky": "^8.0.3",
        "lint-staged": "^13.1.2",
        "prettier": "2.8.4",
        "rollup": "^4.19.1",
        "rollup-plugin-dts": "^6.1.1",
        "typescript": "^4.9.5",
        "vite": "^4.5.0"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.7.4"
    }
}
