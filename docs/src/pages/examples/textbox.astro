---
import DocsLayout from '../../layouts/docs-layout.astro';
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Card, CardContent } from "@/components/ui/card";
---

<script>
    import { Textbox } from "@mnmo";
    import { createLogger } from "@/lib/logger";

    export function initTextboxDemo() {
        // Defines the logger target
        const log = createLogger("#log-textbox");

        // 1. Plain Textbox Init
        const plainEl = document.getElementById(
            "tb-plain",
        ) as HTMLInputElement | null;
        if (plainEl) {
            new Textbox(plainEl, {
                onChange: (input) => {
                    log.info("plain:onChange", {
                        value: input.value,
                        error: input.error,
                        isValid: input.isValid,
                    });
                },
                onInvalid: (input) => {
                    log.warn("plain:onInvalid", input.error);
                },
            });
        }

        // 2. Phone Init
        const phoneEl = document.getElementById(
            "tb-phone",
        ) as HTMLInputElement | null;
        if (phoneEl) {
            new Textbox(phoneEl, {
                onChange: (input) => {
                    log.info("phone:onChange", {
                        value: input.value,
                        error: input.error,
                    });
                },
            });
        }

        // 3. CPF Init
        const cpfEl = document.getElementById(
            "tb-cpf",
        ) as HTMLInputElement | null;
        if (cpfEl) {
            new Textbox(cpfEl, {
                mask: "999.999.999-99",
                valueAs: (v) => v.replace(/\D/g, ""), // keep only digits
                onChange: (input) => {
                    log.info("cpf:onChange", {
                        display: cpfEl.value,
                        value: input.value,
                    });
                },
            });
        }
    }

    initTextboxDemo();
</script>

<DocsLayout
    title="Textbox"
    description="A standard input field with masking capabilities."
>
    <Card>
        <CardContent className="space-y-6">
            <div class="grid gap-2">
                <Label htmlFor="tb-plain">
                    Plain Textbox
                </Label>
                <Input
                    id="tb-plain"
                    type="text"
                    name="plain"
                    required
                    minLength={3}
                    placeholder="Type at least 3 chars"
                />
            </div>

            <!-- Masked Phone -->
            <div class="grid gap-2">
                <Label htmlFor="tb-phone">
                    Masked Phone (attr mask)
                </Label>
                <!-- 
                    The JS library likely looks for the ID.
                    Shadcn Input passes the ID prop down to the HTML element.
                -->
                <Input
                    id="tb-phone"
                    type="tel"
                    name="phone"
                    placeholder="(99) 99999-9999"
                />
            </div>

            <!-- Masked CPF -->
            <div class="grid gap-2">
                <Label htmlFor="tb-cpf">
                    Masked CPF (programmatic)
                </Label>
                <Input
                    id="tb-cpf"
                    type="text"
                    name="cpf"
                    placeholder="999.999.999-99"
                />
            </div>
        </CardContent>
    </Card>

    <div class="rounded-lg border bg-slate-950 text-slate-50 p-4 font-mono text-xs overflow-x-auto max-h-60 mt-6">
        <pre id="log-textbox">Logs will appear here...</pre>
    </div>
</DocsLayout>